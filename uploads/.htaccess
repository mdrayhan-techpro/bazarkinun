# Block PHP and CGI Script Execution in Uploads Directory
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phar|pl|py|cgi|sh|bash|exe|asp|aspx|jsp)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Disable Directory Listing
Options -ExecCGI -Indexes

