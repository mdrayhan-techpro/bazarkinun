# ========================================================
# BazarKinun.com — Production Environment Configuration
# ========================================================

# Application Environment: 'production' or 'development'
APP_ENV=production

# Database Credentials (For TiDB Cloud, use port 4000 and DB_SSL=true)
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=bazarkinun_db
DB_USER=your_tidb_user.root
DB_PASS=your_tidb_password
DB_SSL=true

# Base URL (without trailing slash)
APP_URL=https://bazarkinun.com

# cURL SSL Verification (keep true for production)
CURL_VERIFY_SSL=true

